#  ---------------------------------
#  DATABASE CONFIG
#  DB_HOSTNAME -> host of your postgres server (e.g. localhost, 127.0.0.1, postgres.domain.org, conn.pgx.server.com, 145.167.124.11)
#  DB_USERNAME -> username of your postgres server's user
#  DB_PASSWORD -> password of the user
#  DB_DATABASE -> database name where we'll be storing our info
#  ---------------------------------
DB_HOSTNAME=host
DB_USERNAME=user
DB_PASSWORD=password
DB_DATABASE=database
DB_PORT=5432
#  ---------------------------------
#  PGX POOL CONFIG
#  ---------------------------------
#  POOL_MAX_CONNECTION -> maximum connection that can be created in the pool
#  POOL_MIN_CONNECTION -> minimum connection that should be there by default in the pool
#  POOL_MAX_CONNECTION_IDLE_TIME -> maximum idle time before a connection was idle in the pool (in minutes)
#  POOL_MAX_CONNECTION_LIFETIME_JITTER -> ensures that all the idle connection do not expire all at once (in minutes)
#  POOL_MAX_CONNECTION_LIFETIME -> maximum time that is allowed for connection to exist (in minutes)
#  POOL_HEALTH_CHECK_PERIOD -> time interval before we check for idle connection each time (in minutes)
POOL_MAX_CONNECTION = 25
POOL_MIN_CONNECTION = 5
POOL_MAX_CONNECTION_IDLE_TIME = 5
POOL_MAX_CONNECTION_LIFETIME_JITTER = 3
POOL_MAX_CONNECTION_LIFETIME = 10
POOL_HEALTH_CHECK_PERIOD = 1

#  ---------------------------------
#  GRPC AI CORE HOST CONNECTION
#  ---------------------------------
GRPC_AI_HOST=localhost:50051

#  ---------------------------------
#  Basically number of bits for cryptographically generated bytes which we encode in base64 further
#  which acts as our session token
#  ---------------------------------
USER_SESSION_TOKEN_BYTES=32

#  ---------------------------------
#  HTTP CONFIG FOR FILE UPLOADS, INGESTION TIMEOUTS, LIMITS
#  ---------------------------------
MAX_UPLOAD_MB_PER_FILE=25
MAX_FILES_PER_REQUEST=10
MAX_TOTAL_MB_PER_REQUEST=100
MAX_PAGES_PDF=500
MAX_CHARS_PER_FILE=1000000
INGEST_WORKER_TIMEOUT_MIN=10
INGEST_QUEUE_SIZE=100
ALLOW_URL_FETCH=false
URL_FETCH_TIMEOUT_SEC=10
URL_FETCH_MAX_MB=5
MAX_URLS_PER_REQUEST=10
# Test-only, never enable in production (SSRF bypass).
# URL_FETCH_ALLOW_PRIVATE=false
